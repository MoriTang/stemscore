{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StemFlow",
  "version": "0.1.0",
  "identifier": "com.moritang.stemscore.live",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StemFlow",
        "width": 820,
        "height": 850,
        "minWidth": 640,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$AUDIO/StemScore Recordings/**",
          "$AUDIO/StemScore Separations/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "14.6"
    }
  }
}
